# Copy to .env only when configuring your own PostgreSQL instance.
# For the project-private cluster, run scripts/Start-LocalPostgres.ps1 instead.
# Spring loads .env as Java .properties; do not wrap values in shell quotes.
DB_URL=jdbc:postgresql://127.0.0.1:5433/cv_matching
DB_USERNAME=cv_matching
# TODO: supply your own database role password; never commit .env.
DB_PASSWORD=
